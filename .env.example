# Copy to .env locally. Never commit credentials or personal conversations.
# Local OpenAI-compatible server, e.g. Ollama /v1, or a cloud API /v1 endpoint.
YF_MODEL_BASE_URL=http://127.0.0.1:11434/v1
YF_MODEL_NAME=
YF_MODEL_API_KEY=
# Optional separate model for memory extraction; defaults to the chat model.
YF_MEMORY_MODEL=
# Relative paths are resolved from the repository, not from the launch directory.
YF_DATA_DIR=.local
